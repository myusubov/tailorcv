{
  "name": "tailorcv",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "concurrently \"npm run start --workspace=backend\" \"npm run start:worker --workspace=backend\"",
    "redis": "sh -c \"docker inspect -f '{{.State.Running}}' tailorcv-redis 2>/dev/null | grep -q true || docker start tailorcv-redis >/dev/null 2>&1 || docker run -d --name tailorcv-redis -p 6380:6379 redis:7 >/dev/null\"",
    "dev": "npm run redis && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "concurrently \"npm run dev --workspace=shared\" \"npm run dev --workspace=backend\" \"npm run dev:worker --workspace=backend\"",
    "build": "npm run build -w shared && npm run build -w backend && npm run build -w frontend",
    "test": "npm run test --workspaces --if-present",
    "test:frontend": "npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "test:e2e:frontend": "npm run test:e2e -w frontend",
    "test:e2e:frontend:headed": "npm run test:e2e:headed -w frontend",
    "test:e2e:frontend:forgot-password": "npm run test:e2e -w frontend -- --workers=1 forgot-password.real.spec.ts forgot-password-policy.real.spec.ts",
    "test:e2e:frontend:headed:login": "npm run test:e2e:headed -w frontend -- login.real.spec.ts",
    "test:e2e:frontend:headed:forgot-password": "npm run test:e2e:headed -w frontend -- --workers=1 forgot-password.real.spec.ts forgot-password-policy.real.spec.ts",
    "test:e2e:frontend:real-auth": "npm run test:e2e:real-auth -w frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck:frontend": "npm run type-check -w frontend",
    "typecheck:backend": "npx tsc --noEmit -p apps/backend/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "prisma:migrate:create": "npm run prisma:migrate:create -w backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w backend",
    "prisma:migrate:reset": "npm run prisma:migrate:reset -w backend",
    "prisma:db:push": "npm run prisma:db:push -w backend",
    "prisma:db:seed": "npm run prisma:db:seed -w backend",
    "prisma:studio": "npm run prisma:studio -w backend",
    "prisma:format": "npm run prisma:format -w backend",
    "prisma:validate": "npm run prisma:validate -w backend",
    "db:setup": "npm run db:setup -w backend",
    "db:reset": "npm run db:reset -w backend"
  },
  "devDependencies": {
    "@types/node": "^20",
    "baseline-browser-mapping": "^2.10.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "next": "16.1.6",
    "next-devtools-mcp": "^0.3.10",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@clerk/express": "^1.7.55",
    "@internationalized/date": "^3.10.1",
    "dotenv": "^17.2.3",
    "openai": "^6.15.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  }
}
