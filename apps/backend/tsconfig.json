{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "rootDir": "../..",
    "noEmit": false,
    "esModuleInterop": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "shared": ["../../packages/shared/src"],
      "src/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "types/**/*",
    "prisma/generated/**/*",
    "../../packages/shared/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts"
  ]
}
