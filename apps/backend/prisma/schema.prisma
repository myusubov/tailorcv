generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  clerkUserId       String             @unique
  email             String             @unique
  firstName         String?
  lastName          String?
  plan              Plan               @default(FREE)
  creditsUsed       Int                @default(0)
  creditsLimit      Int                @default(3)
  stripeCustomerId  String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  baseResumes       BaseResume[]
  customizedResumes CustomizedResume[]
  onboardingJobs    OnboardingJob[]
  githubConnection  GitHubConnection?
  analysisJobs      AnalysisJob[]

  @@map("users")
}

model GitHubConnection {
  id              String   @id @default(uuid())
  userId          String   @unique
  accessToken     String
  githubUserId    Int
  githubUsername  String
  githubAvatarUrl String?
  scopes          String   // Space-separated scopes (e.g., "repo read:user")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)

  @@map("github_connections")
}

model BaseResume {
  id                String             @id @default(uuid())
  userId            String
  name              String             @default("My Resume")
  data              Json
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)
  customizedResumes CustomizedResume[]

  @@map("base_resumes")
}

model CustomizedResume {
  id             String     @id @default(uuid())
  userId         String
  baseResumeId   String
  jobTitle       String?
  companyName    String?
  jobDescription String
  customizedData Json
  matchScore     Int?       @default(0)
  createdAt      DateTime   @default(now())
  baseResume     BaseResume @relation(fields: [baseResumeId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)

  @@map("customized_resumes")
}

model OnboardingJob {
  id                 String              @id @default(uuid())
  userId             String
  status             OnboardingJobStatus @default(QUEUED)
  stage              OnboardingJobStage  @default(QUEUED)
  progressPct        Int                 @default(0)
  payload            Json
  result             Json?
  rawAiResponse      Json?
  resultBaseResumeId String?
  error              Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user User @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("onboarding_jobs")
}

model AnalysisJob {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)
  status        AnalysisJobStatus   @default(PENDING)
  repositories  AnalysisRepository[]
  results       AnalysisResult?
  errorMessage  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  completedAt   DateTime?
  @@index([userId, status])

  @@map("analysis_jobs")
}
model AnalysisRepository {
  id          String       @id @default(cuid())
  jobId       String
  job         AnalysisJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  githubRepoId Int
  repoName    String
  repoOwner   String
  repoUrl     String
  commits     Json?        // Analyzed commit data
  pullRequests Json?       // Analyzed PR data
  techStack   String[]     // Detected technologies
  status      RepoAnalysisStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([jobId])

  @@map("analysis_repositories")
}
model AnalysisResult {
  id          String       @id @default(cuid())
  jobId       String       @unique
  job         AnalysisJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bullets     Json         // Array of { text, impact, repo, approved }
  summary     String?      // Overall contribution summary
  topSkills   String[]     // Top skills identified
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("analysis_results")
}

enum Plan {
  FREE
  PRO_MONTHLY
  PRO_LIFETIME
}

enum OnboardingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum OnboardingJobStage {
  QUEUED
  CALLING_AI
  RETRYING
  VALIDATING
  SAVING
  DONE
  FAILED
}

enum AnalysisJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
enum RepoAnalysisStatus {
  PENDING
  FETCHING
  ANALYZING
  COMPLETED
  FAILED
}