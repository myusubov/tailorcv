generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  clerkUserId       String             @unique
  email             String             @unique
  firstName         String?
  lastName          String?
  plan              Plan               @default(FREE)
  creditsUsed       Int                @default(0)
  creditsLimit      Int                @default(3)
  stripeCustomerId  String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  baseResumes       BaseResume[]
  customizedResumes CustomizedResume[]
  onboardingJobs    OnboardingJob[]

  @@map("users")
}

model BaseResume {
  id                String             @id @default(uuid())
  userId            String
  name              String             @default("My Resume")
  data              Json
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)
  customizedResumes CustomizedResume[]

  @@map("base_resumes")
}

model CustomizedResume {
  id             String     @id @default(uuid())
  userId         String
  baseResumeId   String
  jobTitle       String?
  companyName    String?
  jobDescription String
  customizedData Json
  matchScore     Int?       @default(0)
  createdAt      DateTime   @default(now())
  baseResume     BaseResume @relation(fields: [baseResumeId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)

  @@map("customized_resumes")
}

model OnboardingJob {
  id                 String              @id @default(uuid())
  userId             String
  status             OnboardingJobStatus @default(QUEUED)
  stage              OnboardingJobStage  @default(QUEUED)
  progressPct        Int                 @default(0)
  payload            Json
  result             Json?
  rawAiResponse      Json?
  resultBaseResumeId String?
  error              Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user User @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("onboarding_jobs")
}

enum Plan {
  FREE
  PRO_MONTHLY
  PRO_LIFETIME
}

enum OnboardingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum OnboardingJobStage {
  QUEUED
  CALLING_AI
  RETRYING
  VALIDATING
  SAVING
  DONE
  FAILED
}
