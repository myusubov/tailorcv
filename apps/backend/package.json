{
  "name": "backend",
  "version": "0.1.0",
  "main": "src/server.ts",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --include .env src/server.ts",
    "dev:worker": "tsx watch --include .env src/worker-runner.ts",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=production TS_NODE_PROJECT=tsconfig.prod.json node -r tsconfig-paths/register dist/src/server.js",
    "start:worker": "cross-env NODE_ENV=production TS_NODE_PROJECT=tsconfig.prod.json node -r tsconfig-paths/register dist/src/worker-runner.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:db:push": "prisma db push",
    "prisma:db:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:init": "prisma init",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate:deploy && npm run prisma:db:seed",
    "db:reset": "npm run prisma:migrate:reset && npm run prisma:db:seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.0",
    "@bull-board/api": "^6.16.2",
    "@bull-board/express": "^6.16.2",
    "@clerk/backend": "^1.18.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.4.0",
    "bullmq": "^5.66.4",
    "cockatiel": "^3.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "openai": "^6.22.0",
    "p-timeout": "^7.0.1",
    "pg": "^8.13.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^4.3.1",
    "shared": "*",
    "tsconfig-paths": "^3.15.0",
    "unpdf": "^1.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.17.11",
    "@types/pg": "^8.11.10",
    "openai": "^6.22.0",
    "prisma": "^7.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^6.0.4"
  }
}
